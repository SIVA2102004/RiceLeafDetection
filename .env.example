# RiceGuard AI Environment Variables

# App
PROJECT_NAME="RiceGuard AI"
API_V1_STR="/api"
SECRET_KEY="generate-a-secure-random-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Default SQLite for instant local execution, or PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/riceguard"
DATABASE_URL="sqlite:///./riceguard.db"

# AI Inference & Safety
DEMO_MODE=true
MODEL_PATH="./ai/weights/rice_vit_v1.pt"
MIN_CONFIDENCE_THRESHOLD=0.70

# Storage
STORAGE_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# Chatbot & RAG
LLM_API_KEY=""

# Optional Weather Integration
WEATHER_API_KEY=""
